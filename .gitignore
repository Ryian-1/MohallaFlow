#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/


# --- MohallaFlow publication hygiene (local-only / generated material) ---
# Firebase CLI local project alias and emulator / deployment cache
# Developer-local Firebase CLI configuration
/firebase.json
/.firebaserc
/.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log

# Node dependencies (keep package.json and package-lock.json)
**/node_modules/
npm-debug.log*

# Local development backups and historical snapshots (keep locally; do not publish)
/v2_backups/
/v2_validation/
**/*.bak
**/*.bak.*
**/*.before_*.bak

# Flutter / Android / iOS generated or machine-local files
/android/local.properties
/android/key.properties
/android/.gradle/
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/.last_build_id

# Environment-specific Firebase client config; regenerate for each developer project
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Signing credentials and local environment files
*.jks
*.keystore
*.p12
*.mobileprovision
.env
.env.*
!.env.example

# Platform and tool output
*.dSYM.zip
*.app.dSYM
*.xcarchive
*.ipa
*.apk
*.aab

# Generated Firebase options (run FlutterFire CLI for your own project)
/lib/firebase_options.dart

# Non-deployable maintainer-local Firestore Rules snapshot
/firestore.rules

# Accidental npm lockfile at project root (no root package.json)
/package-lock.json

# Internal installation notes and future-feature specifications
/MOHALLAFLOW_FEATURE_REGISTER.md
/README_STAGE4_FIREBASE_DECOUPLING.md
/README_MohallaFlow_*.txt

# Local credentials and private Firebase configuration
.env
.env.*
!.env.example
!.env.*.example
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/*service-account*.json
**/*.pem
**/*.p12
**/*.key
**/*.jks
**/*.keystore

# Local build and tool output
**/.dart_tool/
**/build/
**/node_modules/
**/.firebase/
firebase-debug.log

# MohallaFlow Stage 6 local recovery snapshots — never publish
**/.stage6-*/
**/.v4-worker-ops.*/
**/*.stage6-location-fix-backup
# Temporary private, emulator-only payroll integration fixtures
/.firestore-payroll-sdk-qa-*.rules
/.firebase-payroll-sdk-qa-*.json
# Local MohallaFlow production-release preflight reports
release/firestore/reports/
release/firestore/scripts/__pycache__/
