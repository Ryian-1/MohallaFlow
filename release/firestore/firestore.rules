function validInventoryMovement(data){let itemPath=colonyDocPath(colonyId,'inventoryItems',data.inventoryItemId);

return hasExactKeys(data,['inventoryItemId','itemName','transactionType','quantity','previousQuantity','resultingQuantity','change','reason','reference','performedBy','performedByName','createdAt']) && data.inventoryItemId is string && data.itemName is string && data.itemName.size()>0 && data.transactionType in['stock_in','stock_out','adjustment'] && data.quantity is number && data.quantity>=0 && data.previousQuantity is number && data.previousQuantity>=0 && data.resultingQuantity is number && data.resultingQuantity>=0 && data.change is number && data.reason is string && data.reason.size()>0 && data.reason.size()<=500 && data.reference is string && data.reference.size()<=120 && data.performedBy==uid() && data.performedByName is string && data.performedByName.size()>0 && data.createdAt==request.time && existsAfter(itemPath) && getAfter(itemPath).data.quantityOnHand==data.resultingQuantity && ((exists(itemPath) && get(itemPath).data.quantityOnHand==data.previousQuantity && data.transactionType=='stock_in' && data.quantity>0 && data.resultingQuantity==data.previousQuantity+data.quantity && data.change==data.quantity) || (exists(itemPath) && get(itemPath).data.quantityOnHand==data.previousQuantity && data.transactionType=='stock_out' && data.quantity>0 && data.previousQuantity>=data.quantity && data.resultingQuantity==data.previousQuantity-data.quantity && data.change==0-data.quantity) || (exists(itemPath) && get(itemPath).data.quantityOnHand==data.previousQuantity && data.transactionType=='adjustment' && data.resultingQuantity==data.quantity && data.change==data.resultingQuantity-data.previousQuantity) || (!exists(itemPath) && data.transactionType=='stock_in' && data.previousQuantity==0 && data.quantity>0 && data.resultingQuantity==data.quantity && data.change==data.quantity));

}
allow get,list:if isAdmin(colonyId);

allow create:if isAdmin(colonyId) && validInventoryMovement(newData());

allow update,delete:if false;

}
