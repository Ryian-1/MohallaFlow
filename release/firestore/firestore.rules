rules_version='2';

service cloud.firestore{
match /databases/{database}/documents{
function hasExactKeys(data,fields){return data.keys().hasAll(fields) && data.keys().hasOnly(fields);

}
function colonyDocPath(colonyId,collectionName,documentId){return /databases/$(database)/documents/colonies/$(colonyId)/$(collectionName)/$(documentId);

}
function memberDocPath(colonyId,uid){return colonyDocPath(colonyId,'members',uid);

}
function newData(){return request.resource.data;

}
function oldData(){return resource.data;

}
function uid(){return request.auth.uid;

}
function changedKeys(){return request.resource.data.diff(resource.data).affectedKeys();

}

function payrollRunPath(colonyId,runId){
return /databases/$(database)/documents/colonies/$(colonyId)/colonyPayrollRuns/$(runId);
}

function payrollEntryPath(colonyId,runId,staffId){
return /databases/$(database)/documents/colonies/$(colonyId)/colonyPayrollRuns/$(runId)/entries/$(staffId);
}

function payrollPaymentPath(colonyId,runId,staffId,paymentId){
return /databases/$(database)/documents/colonies/$(colonyId)/colonyPayrollRuns/$(runId)/entries/$(staffId)/payments/$(paymentId);
}


function validPayrollPayoutBundle(colonyId,runId,staffId,paymentId,paymentData){
let runPath=payrollRunPath(colonyId,runId);
let entryPath=payrollEntryPath(colonyId,runId,staffId);
let expensePath=colonyDocPath(colonyId,'colonyExpenses','payroll_'+runId+'_'+staffId+'_'+paymentId);
let runBefore=exists(runPath)?get(runPath).data:{};
let runAfter=existsAfter(runPath)?getAfter(runPath).data:{};
let entryBefore=exists(entryPath)?get(entryPath).data:{};
let entryAfter=existsAfter(entryPath)?getAfter(entryPath).data:{};
let expenseAfter=existsAfter(expensePath)?getAfter(expensePath).data:{};

return hasExactKeys(paymentData,['runId','staffEntryId','expenseId','amount','paymentMethod','reference','notes','recordedBy','recordedByName','recordedAt'])
&& paymentData.runId==runId
&& paymentData.staffEntryId==staffId
&& paymentData.expenseId=='payroll_'+runId+'_'+staffId+'_'+paymentId
&& paymentData.amount is number
&& paymentData.amount>0
&& paymentData.amount<=1000000000
&& paymentData.paymentMethod in['upi','bank_transfer','cash','cheque','other']
&& paymentData.reference is string
&& paymentData.reference.size()<=100
&& paymentData.notes is string
&& paymentData.notes.size()<=500
&& paymentData.recordedBy==uid()
&& paymentData.recordedByName is string
&& paymentData.recordedByName.size()>0
&& paymentData.recordedByName.size()<=120
&& paymentData.recordedAt==request.time
&& exists(runPath)
&& exists(entryPath)
&& existsAfter(expensePath)
&& runBefore.status in['approved','partially_paid']
&& entryBefore.status in['approved','partially_paid']
&& runBefore.paidTotal is number
&& runBefore.balanceTotal is number
&& entryBefore.amountPaid is number
&& entryBefore.balance is number
&& paymentData.amount<=runBefore.balanceTotal
&& paymentData.amount<=entryBefore.balance
&& runAfter.paidTotal==runBefore.paidTotal+paymentData.amount
&& runAfter.balanceTotal==runBefore.balanceTotal-paymentData.amount
&& runAfter.netTotal==runBefore.netTotal
&& runAfter.lastPaymentId==paymentId
&& runAfter.lastPaymentStaffEntryId==staffId
&& runAfter.status==(runAfter.balanceTotal<=0.005?'paid':'partially_paid')
&& runAfter.updatedAt==request.time
&& entryAfter.amountPaid==entryBefore.amountPaid+paymentData.amount
&& entryAfter.balance==entryBefore.balance-paymentData.amount
&& entryAfter.netPay==entryBefore.netPay
&& entryAfter.lastPaymentId==paymentId
&& entryAfter.lastPaidAt==request.time
&& entryAfter.status==(entryAfter.balance<=0.005?'paid':'partially_paid')
&& entryAfter.updatedAt==request.time
&& expenseAfter.payrollRunId==runId
&& expenseAfter.payrollStaffEntryId==staffId
&& expenseAfter.payrollPaymentId==paymentId
&& expenseAfter.category=='staff'
&& expenseAfter.amount==paymentData.amount
&& expenseAfter.amountPaid==paymentData.amount
&& expenseAfter.paymentStatus=='paid'
&& expenseAfter.paymentMethod==paymentData.paymentMethod
&& expenseAfter.reference==paymentData.reference
&& expenseAfter.payeeName==entryBefore.staffName
&& expenseAfter.vendorName==''
&& expenseAfter.assetName==''
&& expenseAfter.createdBy==uid()
&& expenseAfter.createdByName==paymentData.recordedByName
&& expenseAfter.createdAt==request.time
&& expenseAfter.updatedAt==request.time;
}
function validPayrollExpenseCreation(colonyId,expenseId,data){
let runValue=data.get('payrollRunId','');
let staffValue=data.get('payrollStaffEntryId','');
let paymentValue=data.get('payrollPaymentId','');
let safeRunId=runValue is string?runValue:'__invalid__';
let safeStaffId=staffValue is string?staffValue:'__invalid__';
let safePaymentId=paymentValue is string?paymentValue:'__invalid__';
let paymentPath=payrollPaymentPath(colonyId,safeRunId,safeStaffId,safePaymentId);
let paymentData=existsAfter(paymentPath)?getAfter(paymentPath).data:{};

return runValue is string
&& staffValue is string
&& paymentValue is string
&& expenseId=='payroll_'+safeRunId+'_'+safeStaffId+'_'+safePaymentId
&& existsAfter(paymentPath)
&& paymentData.runId==safeRunId
&& paymentData.staffEntryId==safeStaffId
&& paymentData.expenseId==expenseId
&& paymentData.amount==data.amount
&& paymentData.paymentMethod==data.paymentMethod
&& paymentData.reference==data.reference
&& paymentData.recordedBy==uid()
&& paymentData.recordedByName==data.createdByName
&& paymentData.recordedAt==request.time;
}
function validPayrollRunData(data,runId){
return data.keys().hasAll(['periodKey','periodStart','periodEnd','payDate','monthlyProrationDivisor','status','staffCount','grossTotal','deductionTotal','netTotal','paidTotal','balanceTotal','createdBy','createdByName','createdAt','updatedAt'])
&& data.keys().hasOnly(['periodKey','periodStart','periodEnd','payDate','monthlyProrationDivisor','status','staffCount','grossTotal','deductionTotal','netTotal','paidTotal','balanceTotal','createdBy','createdByName','createdAt','updatedAt','approvedBy','approvedByName','approvedAt','lastPaymentId','lastPaymentStaffEntryId'])
&& data.periodKey==runId
&& data.periodKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
&& data.periodStart is string
&& data.periodStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
&& data.periodEnd is string
&& data.periodEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
&& data.periodStart<=data.periodEnd
&& data.payDate is string
&& data.payDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
&& data.monthlyProrationDivisor is number
&& data.monthlyProrationDivisor>0
&& data.monthlyProrationDivisor<=31
&& data.status in['draft','approved','partially_paid','paid']
&& data.staffCount is int
&& data.staffCount>=1
&& data.staffCount<=400
&& data.grossTotal is number
&& data.grossTotal>=0
&& data.grossTotal<=1000000000
&& data.deductionTotal is number
&& data.deductionTotal>=0
&& data.deductionTotal<=1000000000
&& data.netTotal is number
&& data.netTotal>=0
&& data.netTotal<=1000000000
&& data.paidTotal is number
&& data.paidTotal>=0
&& data.paidTotal<=data.netTotal
&& data.balanceTotal is number
&& data.balanceTotal>=0
&& data.balanceTotal<=data.netTotal
&& data.createdBy is string
&& data.createdBy.size()>0
&& data.createdByName is string
&& data.createdByName.size()>0
&& data.createdByName.size()<=120
&& data.createdAt is timestamp
&& data.updatedAt is timestamp
&& ((data.status=='draft'
&& !data.keys().hasAny(['approvedBy','approvedByName','approvedAt'])
&& data.paidTotal==0
&& data.balanceTotal==0)
|| (data.status!='draft'
&& data.approvedBy is string
&& data.approvedBy.size()>0
&& data.approvedByName is string
&& data.approvedByName.size()>0
&& data.approvedByName.size()<=120
&& data.approvedAt is timestamp))
&& ((data.status in['draft','approved']
&& !data.keys().hasAny(['lastPaymentId','lastPaymentStaffEntryId']))
|| (data.keys().hasAll(['lastPaymentId','lastPaymentStaffEntryId'])
&& data.lastPaymentId is string
&& data.lastPaymentId.size()>0
&& data.lastPaymentStaffEntryId is string
&& data.lastPaymentStaffEntryId.size()>0));
}

function validPayrollEntryData(data,staffId){
return data.keys().hasAll(['staffId','staffCode','staffName','phoneSnapshot','department','designation','employmentType','payBasis','baseRate','hra','transportAllowance','otherAllowance','defaultDeduction','linkedWorkerId','linkedWorkerName','attendanceDays','paidDays','paidLeaveDays','unpaidLeaveDays','approvedPaidLeaveDays','approvedUnpaidLeaveDays','hoursWorked','overtimeHours','overtimeRate','bonus','reimbursements','advanceRecovery','otherDeductions','amountPaid','status','createdAt','updatedAt','basePay','overtimePay','grossPay','totalDeductions','netPay','balance'])
&& data.keys().hasOnly(['staffId','staffCode','staffName','phoneSnapshot','department','designation','employmentType','payBasis','baseRate','hra','transportAllowance','otherAllowance','defaultDeduction','linkedWorkerId','linkedWorkerName','attendanceDays','paidDays','paidLeaveDays','unpaidLeaveDays','approvedPaidLeaveDays','approvedUnpaidLeaveDays','hoursWorked','overtimeHours','overtimeRate','bonus','reimbursements','advanceRecovery','otherDeductions','amountPaid','status','createdAt','updatedAt','basePay','overtimePay','grossPay','totalDeductions','netPay','balance','approvedAt','lastPaidAt','lastPaymentId'])
&& data.staffId==staffId
&& data.staffCode is string
&& data.staffCode.size()>0
&& data.staffCode.size()<=40
&& data.staffName is string
&& data.staffName.size()>0
&& data.staffName.size()<=120
&& data.phoneSnapshot is string
&& data.phoneSnapshot.size()<=25
&& data.department is string
&& data.department.size()<=80
&& data.designation is string
&& data.designation.size()<=80
&& data.employmentType is string
&& data.employmentType.size()>0
&& data.employmentType.size()<=40
&& data.payBasis in['monthly','daily','hourly']
&& data.baseRate is number
&& data.baseRate>0
&& data.baseRate<=1000000000
&& data.hra is number
&& data.hra>=0
&& data.transportAllowance is number
&& data.transportAllowance>=0
&& data.otherAllowance is number
&& data.otherAllowance>=0
&& data.defaultDeduction is number
&& data.defaultDeduction>=0
&& data.linkedWorkerId is string
&& data.linkedWorkerName is string
&& data.linkedWorkerName.size()<=120
&& data.attendanceDays is number
&& data.attendanceDays>=0
&& data.paidDays is number
&& data.paidDays>=0
&& data.paidLeaveDays is number
&& data.paidLeaveDays>=0
&& data.unpaidLeaveDays is number
&& data.unpaidLeaveDays>=0
&& data.approvedPaidLeaveDays is number
&& data.approvedPaidLeaveDays>=0
&& data.approvedUnpaidLeaveDays is number
&& data.approvedUnpaidLeaveDays>=0
&& data.hoursWorked is number
&& data.hoursWorked>=0
&& data.overtimeHours is number
&& data.overtimeHours>=0
&& data.overtimeRate is number
&& data.overtimeRate>=0
&& data.bonus is number
&& data.bonus>=0
&& data.reimbursements is number
&& data.reimbursements>=0
&& data.advanceRecovery is number
&& data.advanceRecovery>=0
&& data.otherDeductions is number
&& data.otherDeductions>=0
&& data.amountPaid is number
&& data.amountPaid>=0
&& data.basePay is number
&& data.basePay>=0
&& data.overtimePay is number
&& data.overtimePay>=0
&& data.grossPay is number
&& data.grossPay>=0
&& data.totalDeductions is number
&& data.totalDeductions>=0
&& data.netPay is number
&& data.netPay>=0
&& data.balance is number
&& data.balance>=0
&& data.balance<=data.netPay
&& data.amountPaid<=data.netPay
&& data.status in['draft','approved','partially_paid','paid']
&& data.createdAt is timestamp
&& data.updatedAt is timestamp
&& ((data.status=='draft'
&& data.amountPaid==0
&& data.balance==data.netPay
&& !data.keys().hasAny(['approvedAt','lastPaidAt','lastPaymentId']))
|| (data.status=='approved'
&& data.approvedAt is timestamp
&& data.amountPaid==0
&& data.balance==data.netPay
&& !data.keys().hasAny(['lastPaidAt','lastPaymentId']))
|| (data.status=='partially_paid'
&& data.approvedAt is timestamp
&& data.amountPaid>0
&& data.balance>0.005
&& data.lastPaidAt is timestamp
&& data.lastPaymentId is string
&& data.lastPaymentId.size()>0)
|| (data.status=='paid'
&& data.approvedAt is timestamp
&& data.amountPaid>0
&& data.balance<=0.005
&& data.lastPaidAt is timestamp
&& data.lastPaymentId is string
&& data.lastPaymentId.size()>0));
}

function validPayrollEntryCreate(colonyId,runId,staffId){
let runPath=payrollRunPath(colonyId,runId);

return !exists(runPath)
&& existsAfter(runPath)
&& getAfter(runPath).data.status=='draft'
&& getAfter(runPath).data.periodKey==runId
&& getAfter(runPath).data.createdBy==uid()
&& getAfter(runPath).data.createdAt==request.time
&& newData().status=='draft'
&& newData().amountPaid==0
&& newData().createdAt==request.time
&& newData().updatedAt==request.time
&& validPayrollEntryData(newData(),staffId);
}
function validPayrollEntryDraftEdit(colonyId,runId,staffId){
let runPath=payrollRunPath(colonyId,runId);

return oldData().status=='draft'
&& newData().status=='draft'
&& exists(runPath)
&& get(runPath).data.status=='draft'
&& newData().staffId==staffId
&& newData().staffId==oldData().staffId
&& newData().createdAt==oldData().createdAt
&& newData().amountPaid==0
&& newData().updatedAt==request.time
&& changedKeys().hasOnly(['paidDays','paidLeaveDays','unpaidLeaveDays','hoursWorked','overtimeHours','overtimeRate','bonus','reimbursements','advanceRecovery','otherDeductions','basePay','overtimePay','grossPay','totalDeductions','netPay','balance','updatedAt'])
&& newData().paidDays is number && newData().paidDays>=0
&& newData().paidLeaveDays is number && newData().paidLeaveDays>=0
&& newData().unpaidLeaveDays is number && newData().unpaidLeaveDays>=0
&& newData().hoursWorked is number && newData().hoursWorked>=0
&& newData().overtimeHours is number && newData().overtimeHours>=0
&& newData().overtimeRate is number && newData().overtimeRate>=0
&& newData().bonus is number && newData().bonus>=0
&& newData().reimbursements is number && newData().reimbursements>=0
&& newData().advanceRecovery is number && newData().advanceRecovery>=0
&& newData().otherDeductions is number && newData().otherDeductions>=0
&& newData().basePay is number && newData().basePay>=0
&& newData().overtimePay is number && newData().overtimePay>=0
&& newData().grossPay is number && newData().grossPay>=0
&& newData().totalDeductions is number && newData().totalDeductions>=0
&& newData().netPay is number && newData().netPay>=0
&& newData().balance==newData().netPay;
}


function validPayrollRunPayout(colonyId,runId){
let staffValue=newData().get('lastPaymentStaffEntryId','');
let paymentValue=newData().get('lastPaymentId','');
let safeStaffId=staffValue is string?staffValue:'__invalid__';
let safePaymentId=paymentValue is string?paymentValue:'__invalid__';
let paymentPath=payrollPaymentPath(colonyId,runId,safeStaffId,safePaymentId);
let paymentData=existsAfter(paymentPath)?getAfter(paymentPath).data:{};

return oldData().status in['approved','partially_paid']
&& newData().status in['partially_paid','paid']
&& !exists(paymentPath)
&& existsAfter(paymentPath)
&& paymentData.runId==runId
&& paymentData.staffEntryId==safeStaffId
&& paymentData.recordedBy==uid()
&& paymentData.amount is number
&& paymentData.amount>0
&& paymentData.amount<=oldData().balanceTotal
&& newData().paidTotal==oldData().paidTotal+paymentData.amount
&& newData().balanceTotal==oldData().balanceTotal-paymentData.amount
&& newData().lastPaymentId==safePaymentId
&& newData().lastPaymentStaffEntryId==safeStaffId
&& newData().status==(newData().balanceTotal<=0.005?'paid':'partially_paid')
&& newData().updatedAt==request.time
&& changedKeys().hasOnly(['paidTotal','balanceTotal','status','lastPaymentId','lastPaymentStaffEntryId','updatedAt']);
}
function validPayrollEntryPayout(colonyId,runId,staffId){
let paymentValue=newData().get('lastPaymentId','');
let safePaymentId=paymentValue is string?paymentValue:'__invalid__';
let paymentPath=payrollPaymentPath(colonyId,runId,staffId,safePaymentId);
let paymentData=existsAfter(paymentPath)?getAfter(paymentPath).data:{};

return oldData().status in['approved','partially_paid']
&& newData().status in['partially_paid','paid']
&& !exists(paymentPath)
&& existsAfter(paymentPath)
&& paymentData.runId==runId
&& paymentData.staffEntryId==staffId
&& paymentData.recordedBy==uid()
&& paymentData.amount is number
&& paymentData.amount>0
&& paymentData.amount<=oldData().balance
&& newData().amountPaid==oldData().amountPaid+paymentData.amount
&& newData().balance==oldData().balance-paymentData.amount
&& newData().netPay==oldData().netPay
&& newData().lastPaymentId==safePaymentId
&& newData().lastPaidAt==request.time
&& newData().status==(newData().balance<=0.005?'paid':'partially_paid')
&& newData().updatedAt==request.time
&& changedKeys().hasOnly(['amountPaid','balance','status','lastPaidAt','lastPaymentId','updatedAt']);
}
function isSignedIn(){return request.auth!=null;

}
function isOwnAccount(userId){return isSignedIn() && uid()==userId;

}
function isActiveColonyMember(colonyId){return isSignedIn() && exists(colonyDocPath(colonyId,'members',uid())) && get(colonyDocPath(colonyId,'members',uid())).data.uid==uid() && get(colonyDocPath(colonyId,'members',uid())).data.colonyId==colonyId && get(colonyDocPath(colonyId,'members',uid())).data.status=='active';

}
function isAdmin(colonyId){return isSignedIn() && hasActiveRoleForColonyAdminCheck(colonyId,uid(),'admin');

}
function hasActiveRoleForColonyAdminCheck(colonyId,uid,expectedRole){let memberPath=colonyDocPath(colonyId,'members',uid);

let memberExists=exists(memberPath);

let member=memberExists?get(memberPath).data:{};

return memberExists && member.uid==uid && member.colonyId==colonyId && member.role==expectedRole && member.status=='active';

}
function isManager(colonyId){return isSignedIn() && exists(colonyDocPath(colonyId,'members',uid())) && get(colonyDocPath(colonyId,'members',uid())).data.uid==uid() && get(colonyDocPath(colonyId,'members',uid())).data.colonyId==colonyId && get(colonyDocPath(colonyId,'members',uid())).data.role=='cleanliness_manager' && get(colonyDocPath(colonyId,'members',uid())).data.status=='active';

}
function isColonyGateOperator(colonyId){let memberPath=colonyDocPath(colonyId,'members',uid());

let operatorPath=colonyDocPath(colonyId,'gateOperators',uid());

return isWorker(colonyId) && exists(operatorPath) && get(operatorPath).data.uid==uid() && get(operatorPath).data.isActive==true && get(operatorPath).data.workerId==get(memberPath).data.workerId;

}
function isResident(colonyId){return isSignedIn() && hasActiveResidentForColonyCheck(colonyId,uid());

}
function hasActiveResidentForColonyCheck(colonyId,uid){let memberPath=colonyDocPath(colonyId,'members',uid);

let memberExists=exists(memberPath);

let member=memberExists?get(memberPath).data:{};

let residentId=member.get('residentId','');

return memberExists && member.uid==uid && member.colonyId==colonyId && member.role=='resident' && member.status=='active' && residentId is string && residentId.size()>0;

}
function isOwnResidentRecord(colonyId,residentId){return isResident(colonyId) && get(colonyDocPath(colonyId,'members',uid())).data.residentId==residentId;

}
function isResidentInHousehold(colonyId,householdId){return isResident(colonyId) && exists(colonyDocPath(colonyId,'residents',get(memberDocPath(colonyId,uid())).data.residentId)) && get(colonyDocPath(colonyId,'residents',get(memberDocPath(colonyId,uid())).data.residentId)).data.residentStatus=='active' && get(colonyDocPath(colonyId,'residents',get(memberDocPath(colonyId,uid())).data.residentId)).data.householdId==householdId;

}
function isWorker(colonyId){return isSignedIn() && exists(colonyDocPath(colonyId,'members',uid())) && get(colonyDocPath(colonyId,'members',uid())).data.uid==uid() && get(colonyDocPath(colonyId,'members',uid())).data.colonyId==colonyId && get(colonyDocPath(colonyId,'members',uid())).data.role=='worker' && get(colonyDocPath(colonyId,'members',uid())).data.status=='active' && get(colonyDocPath(colonyId,'members',uid())).data.workerId is string && get(colonyDocPath(colonyId,'members',uid())).data.workerId.size()>0;

}
function isOwnCleanlinessWorkerRecord(colonyId,workerId){return isWorker(colonyId) && get(colonyDocPath(colonyId,'members',uid())).data.workerId==workerId;

}
function isAssignedWorker(colonyId,taskData){return isWorker(colonyId) && taskData.assignedWorkerId==get(colonyDocPath(colonyId,'members',uid())).data.workerId;

}

function linkedWorkerComplaintIsResolved(colonyId,taskId,taskData){let complaintId=taskData.get('sourceComplaintId','');

let safeComplaintId=complaintId is string?complaintId:'__invalid_complaint_id__';

let complaintPath=colonyDocPath(colonyId,'complaints',safeComplaintId);

return complaintId is string && complaintId.size()>0 && exists(complaintPath) && getAfter(complaintPath).data.status=='resolved' && getAfter(complaintPath).data.resolutionTaskId==taskId;

}
function validWorkerComplaintResolution(colonyId,complaintId){let taskId=request.resource.data.get('resolutionTaskId','');

let safeTaskId=taskId is string?taskId:'__invalid_task_id__';

let memberPath=colonyDocPath(colonyId,'members',uid());

let memberExists=exists(memberPath);

let member=memberExists?get(memberPath).data:{};

let taskPath=colonyDocPath(colonyId,'cleanlinessTasks',safeTaskId);

let taskExists=exists(taskPath);

let task=taskExists?get(taskPath).data:{};

let taskAfter=taskExists?getAfter(taskPath).data:{};

return isSignedIn() && memberExists && member.uid==uid() && member.colonyId==colonyId && member.role=='worker' && member.status=='active' && member.workerId is string && member.workerId.size()>0 && taskId is string && taskId.size()>0 && taskExists && task.assignedWorkerId==member.workerId && task.get('sourceComplaintId','')==complaintId && task.status=='in_progress' && taskAfter.status=='completed' && taskAfter.completedAt==request.time && resource.data.complaintType=='cleanliness' && resource.data.status in['acknowledged','in_progress'] && request.resource.data.status=='resolved' && request.resource.data.updatedAt==request.time && request.resource.data.resolvedAt==request.time;

}
function isActiveCommitteeGrant(colonyId){return isResident(colonyId) && exists(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())) && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.userUid==uid() && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.status=='active' && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.startsAt is timestamp && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.startsAt<=request.time && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.expiresAt is timestamp && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.expiresAt>request.time && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.permissions is list && get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.committeeMemberId is string && exists(colonyDocPath(colonyId,'rwaCommitteeMembers',get(/databases/$(database)/documents/colonies/$(colonyId)/rwaCommitteePermissions/$(uid())).data.committeeMemberId)) && get(colonyDocPath(colonyId,'rwaCommitteeMembers',get(/databases/$(database)/documents/colonies/$(colonyId)/rwaCommitteePermissions/$(uid())).data.committeeMemberId)).data.status=='active' && get(colonyDocPath(colonyId,'rwaCommitteeMembers',get(/databases/$(database)/documents/colonies/$(colonyId)/rwaCommitteePermissions/$(uid())).data.committeeMemberId)).data.linkedUserUid==uid();

}
function hasCommitteePermission(colonyId,permission){return isActiveCommitteeGrant(colonyId) && permission in get(colonyDocPath(colonyId,'rwaCommitteePermissions',uid())).data.permissions;

}
function isActiveResidentAccount(colonyId,userUid){return exists(colonyDocPath(colonyId,'members',userUid)) && get(colonyDocPath(colonyId,'members',userUid)).data.uid==userUid && get(colonyDocPath(colonyId,'members',userUid)).data.role=='resident' && get(colonyDocPath(colonyId,'members',userUid)).data.status=='active' && get(colonyDocPath(colonyId,'members',userUid)).data.residentId is string && get(colonyDocPath(colonyId,'members',userUid)).data.residentId.size()>0 && exists(colonyDocPath(colonyId,'residents',get(/databases/$(database)/documents/colonies/$(colonyId)/members/$(userUid)).data.residentId)) && get(colonyDocPath(colonyId,'residents',get(/databases/$(database)/documents/colonies/$(colonyId)/members/$(userUid)).data.residentId)).data.residentStatus!='inactive';

}
