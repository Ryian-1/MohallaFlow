function validWaterStorageMovement(data,colonyId){let storagePath=colonyDocPath(colonyId,'waterStorageAssets',data.storageId);

let beforeLevel=get(storagePath).data.currentLevelLitres;

let afterLevel=getAfter(storagePath).data.currentLevelLitres;

return hasExactKeys(data,['storageId','storageName','movementType','quantityLitres','balanceAfterLitres','reference','notes','createdBy','createdAt']) && data.storageId is string && data.storageId.size()>0 && data.storageName is string && data.movementType in['receipt','issue','distribution'] && data.quantityLitres is number && data.quantityLitres>0 && data.balanceAfterLitres is number && data.balanceAfterLitres>=0 && data.reference is string && data.notes is string && data.createdBy==uid() && data.createdAt==request.time && exists(storagePath) && getAfter(storagePath).data.currentLevelLitres==data.balanceAfterLitres && ((data.movementType=='receipt' && afterLevel==beforeLevel+data.quantityLitres) || (data.movementType in['issue','distribution'] && afterLevel==beforeLevel-data.quantityLitres));

}
