function isOwnVisitorHost(colonyId,data){
  let memberPath=colonyDocPath(colonyId,'members',uid());
  let member=get(memberPath).data;
  let residentId=member.get('residentId','');
  let safeResidentId=residentId is string?residentId:'__invalid_resident__';
  let residentPath=colonyDocPath(colonyId,'residents',safeResidentId);

  return member.uid==uid()
    && member.colonyId==colonyId
    && member.role=='resident'
    && member.status=='active'
    && data.hostUid==uid()
    && residentId is string
    && residentId.size()>0
    && data.hostResidentId==residentId
    && get(residentPath).data.residentStatus=='active';
}

