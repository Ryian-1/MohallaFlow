match /visitors/{visitorId}{
function validVisitorPreRegistration(colonyId,data){
  return data.visitType=='pre_registered'
    && data.hostUid==uid()
    && data.createdBy==uid()
    && data.createdByRole=='resident'
    && data.updatedBy==uid()
    && isOwnVisitorHost(colonyId,data)
    && data.status=='expected'
    && data.expectedAt>request.time
    && data.checkedInAt==null
    && data.checkedOutAt==null
    && data.cancelledAt==null
    && data.createdAt==request.time
    && data.updatedAt==request.time
    && validVisitorRecord(data);
}

function validVisitorWalkIn(colonyId,data){
  return data.visitType=='walk_in'
    && data.status=='checked_in'
    && (isAdmin(colonyId)||isColonyGateOperator(colonyId))
    && data.hostUid==null
    && data.hostResidentId==null
    && data.createdByRole in['admin','gate_operator']
    && data.createdBy==uid()
    && data.updatedBy==uid()
    && data.expectedAt<=request.time
    && data.checkedInAt==request.time
    && data.checkedOutAt==null
    && data.cancelledAt==null
    && data.createdAt==request.time
    && data.updatedAt==request.time
    && validVisitorRecord(data);
}

function validVisitorCreate(colonyId,data){
  return data.visitType=='pre_registered'
    ? validVisitorPreRegistration(colonyId,data)
    : (data.visitType=='walk_in'
      ? validVisitorWalkIn(colonyId,data)
      : false);
}

