function validMaintenancePaymentBillIncrement(data,colonyId){
let billPath=colonyDocPath(colonyId,'maintenanceBills',data.billId);
let billBefore=get(billPath).data;
let billAfter=getAfter(billPath).data;

return billBefore.householdId==data.householdId
&& billAfter.householdId==data.householdId
&& billAfter.totalAmount==billBefore.totalAmount
&& billAfter.amountPaid==billBefore.amountPaid+data.amount
&& billAfter.amountPaid<=billAfter.totalAmount
&& billAfter.updatedAt==request.time
&& ((billAfter.amountPaid==billAfter.totalAmount && billAfter.status=='paid')
|| (billAfter.amountPaid>0 && billAfter.amountPaid<billAfter.totalAmount
&& billAfter.status=='partially_paid'));
}

function validColonyNotification(data){
return data.keys().hasAll(['title','message','eventType','recipientKeys','sourceCollection','sourceId','createdBy','createdAt'])
&& data.keys().hasOnly(['title','message','eventType','recipientKeys','sourceCollection','sourceId','createdBy','createdAt','recipientKey'])
&& data.title is string && data.title.size()>0 && data.title.size()<=120
&& data.message is string && data.message.size()>0 && data.message.size()<=500
&& data.eventType in['complaint_submitted','complaint_status_changed','task_assigned','task_status_changed','maintenance_job_updated','announcement_published','visitor_registered','visitor_checked_in','visitor_checked_out','housekeeping_submitted','housekeeping_assigned','housekeeping_updated','water_delivery_updated','bill_issued','payment_submitted','payment_verified','payment_rejected']
&& data.recipientKeys is list && data.recipientKeys.size()>0 && data.recipientKeys.size()<=30
&& (!data.keys().hasAny(['recipientKey']) || (data.recipientKey is string && data.recipientKey.size()>0 && data.recipientKey.size()<=160 && data.recipientKeys.hasAny([data.recipientKey])))
&& ((data.eventType in['complaint_submitted','complaint_status_changed'] && data.sourceCollection=='complaints') || (data.eventType in['task_assigned','task_status_changed'] && data.sourceCollection=='cleanlinessTasks') || (data.eventType=='maintenance_job_updated' && data.sourceCollection=='maintenanceJobs') || (data.eventType=='announcement_published' && data.sourceCollection=='announcements') || (data.eventType in['visitor_registered','visitor_checked_in','visitor_checked_out'] && data.sourceCollection=='visitors') || (data.eventType in['housekeeping_submitted','housekeeping_assigned','housekeeping_updated'] && data.sourceCollection=='housekeepingRequests') || (data.eventType=='water_delivery_updated' && data.sourceCollection=='waterDeliveries') || (data.eventType=='bill_issued' && data.sourceCollection=='maintenanceBills') || (data.eventType in['payment_submitted','payment_verified','payment_rejected'] && data.sourceCollection=='maintenancePayments'))
&& data.sourceId is string && data.sourceId.size()>0 && data.createdBy==uid() && data.createdAt==request.time;

}
function canReadColonyNotification(colonyId,data){
let scalarKey=data.get('recipientKey','');
return isActiveColonyMember(colonyId)
&& (
  scalarKey=='role:'+get(memberDocPath(colonyId,uid())).data.role
  || scalarKey=='user:'+uid()
  || (isWorker(colonyId) && scalarKey=='worker:'+get(memberDocPath(colonyId,uid())).data.workerId)
  || (!data.keys().hasAny(['recipientKey']) && data.get('recipientKeys',[]) is list && data.get('recipientKeys',[]).hasAny(['role:'+get(memberDocPath(colonyId,uid())).data.role,'user:'+uid()]))
  || (!data.keys().hasAny(['recipientKey']) && isWorker(colonyId) && data.get('recipientKeys',[]) is list && data.get('recipientKeys',[]).hasAny(['worker:'+get(memberDocPath(colonyId,uid())).data.workerId]))
);

}
function validResidentComplaintNotification(data,colonyId){let complaintPath=colonyDocPath(colonyId,'complaints',data.sourceId);

return isResident(colonyId) && data.eventType=='complaint_submitted' && data.sourceCollection=='complaints' && data.recipientKeys.hasAll(['role:admin']) && data.recipientKeys.hasOnly(['role:admin','role:cleanliness_manager']) && !exists(complaintPath) && existsAfter(complaintPath) && getAfter(complaintPath).data.submittedBy==uid() && getAfter(complaintPath).data.status=='submitted' && ((getAfter(complaintPath).data.complaintType=='cleanliness' && data.recipientKeys.hasAny(['role:cleanliness_manager'])) || (getAfter(complaintPath).data.complaintType!='cleanliness' && !data.recipientKeys.hasAny(['role:cleanliness_manager'])));

}
function validAdminComplaintStatusNotification(data,colonyId){let complaintPath=colonyDocPath(colonyId,'complaints',data.sourceId);

return isAdmin(colonyId) && data.eventType=='complaint_status_changed' && data.sourceCollection=='complaints' && exists(complaintPath) && get(complaintPath).data.submittedBy is string && data.recipientKeys.hasAll(['user:'+get(complaintPath).data.submittedBy]) && data.recipientKeys.hasOnly(['user:'+get(complaintPath).data.submittedBy]) && getAfter(complaintPath).data.status!=get(complaintPath).data.status;

}
function validTaskAssignedNotification(data,colonyId){let taskPath=colonyDocPath(colonyId,'cleanlinessTasks',data.sourceId);

return(isAdmin(colonyId) || isManager(colonyId)) && data.eventType=='task_assigned' && data.sourceCollection=='cleanlinessTasks' && !exists(taskPath) && existsAfter(taskPath) && getAfter(taskPath).data.status=='assigned' && getAfter(taskPath).data.createdBy==uid() && getAfter(taskPath).data.assignedWorkerId is string && data.recipientKeys.hasAll(['worker:'+getAfter(taskPath).data.assignedWorkerId]) && data.recipientKeys.hasOnly(['worker:'+getAfter(taskPath).data.assignedWorkerId]);

}
function validManagerTaskStatusNotification(data,colonyId){let taskPath=colonyDocPath(colonyId,'cleanlinessTasks',data.sourceId);

return(isAdmin(colonyId) || isManager(colonyId)) && data.eventType=='task_status_changed' && data.sourceCollection=='cleanlinessTasks' && exists(taskPath) && get(taskPath).data.assignedWorkerId is string && data.recipientKeys.hasAll(['worker:'+get(taskPath).data.assignedWorkerId]) && data.recipientKeys.hasOnly(['worker:'+get(taskPath).data.assignedWorkerId]) && getAfter(taskPath).data.status!=get(taskPath).data.status;

}
function validMaintenanceJobUpdateNotification(data,colonyId){let jobPath=colonyDocPath(colonyId,'maintenanceJobs',data.sourceId);

return isAdmin(colonyId) && data.eventType=='maintenance_job_updated' && data.sourceCollection=='maintenanceJobs' && exists(jobPath) && get(jobPath).data.sourceComplaintId is string && exists(colonyDocPath(colonyId,'complaints',get(jobPath).data.sourceComplaintId)) && get(colonyDocPath(colonyId,'complaints',get(jobPath).data.sourceComplaintId)).data.submittedBy is string && data.recipientKeys.hasAll(['user:'+get(colonyDocPath(colonyId,'complaints',get(jobPath).data.sourceComplaintId)).data.submittedBy]) && data.recipientKeys.hasOnly(['user:'+get(colonyDocPath(colonyId,'complaints',get(jobPath).data.sourceComplaintId)).data.submittedBy]) && getAfter(jobPath).data.status!=get(jobPath).data.status;

}
// Backward-compatible collection-group discovery for legacy clients.
// The caller must constrain both uid and status in the query. This restores
// the previous production rule's recursive members collection contract.
match /{path=**}/members/{memberId} {
  allow list: if request.auth != null
    && resource.data.uid == request.auth.uid
    && resource.data.status == 'active';
}
match /users/{userId}{
allow get:if isOwnAccount(userId);

allow list:if false;

allow create,update,delete:if false;

}
match /colonies/{colonyId}{
function validTenantLease(data){return data.keys().hasAll(['householdId','blockId','houseNumber','householdHeadName','tenantResidentId','tenantName','tenantPhone','leaseStart','leaseEnd','monthlyRent','securityDeposit','agreementReference','status','createdBy','createdAt','updatedAt']) && data.keys().hasOnly(['householdId','blockId','houseNumber','householdHeadName','tenantResidentId','tenantName','tenantPhone','leaseStart','leaseEnd','monthlyRent','securityDeposit','agreementReference','status','createdBy','createdAt','updatedAt','terminationNote','terminatedAt','terminatedBy']) && data.householdId is string && data.householdId.size()>0 && exists(colonyDocPath(colonyId,'households',data.householdId)) && data.tenantResidentId is string && data.tenantResidentId.size()>0 && exists(colonyDocPath(colonyId,'residents',data.tenantResidentId)) && get(colonyDocPath(colonyId,'residents',data.tenantResidentId)).data.householdId==data.householdId && get(colonyDocPath(colonyId,'residents',data.tenantResidentId)).data.relationshipToHead=='Tenant' && data.tenantName is string && data.tenantName.size()>0 && data.tenantPhone is string && data.blockId is string && data.houseNumber is string && data.householdHeadName is string && data.leaseStart is timestamp && data.leaseEnd is timestamp && data.leaseEnd>data.leaseStart && data.monthlyRent is number && data.monthlyRent>=0 && data.securityDeposit is number && data.securityDeposit>=0 && data.agreementReference is string && data.agreementReference.size()<=120 && data.status=='active' && data.createdBy==uid() && data.createdAt==request.time && data.updatedAt==request.time;

}
match /tenantLeases/{leaseId}{
allow get,list:if isAdmin(colonyId) || (isResident(colonyId) && isOwnResidentRecord(colonyId,oldData().tenantResidentId));

allow create:if isAdmin(colonyId) && validTenantLease(newData());

allow update:if(isAdmin(colonyId) && oldData().status=='active' && newData().status=='terminated' && changedKeys().hasOnly(['status','terminationNote','terminatedAt','terminatedBy','updatedAt']) && newData().terminationNote is string && newData().terminationNote.size()>=5 && newData().terminationNote.size()<=500 && newData().terminatedAt==request.time && newData().terminatedBy==uid() && newData().updatedAt==request.time) || (isAdmin(colonyId) && oldData().status=='active' && newData().status=='active' && changedKeys().hasOnly(['leaseEnd','updatedAt','lastRenewalRequestId','renewedAt','renewedBy']) && newData().leaseEnd is timestamp && newData().leaseEnd>oldData().leaseEnd && newData().updatedAt==request.time && newData().renewedAt==request.time && newData().renewedBy==uid() && newData().lastRenewalRequestId is string && existsAfter(colonyDocPath(colonyId,'tenantLeaseRenewalRequests',newData().lastRenewalRequestId)) && getAfter(colonyDocPath(colonyId,'tenantLeaseRenewalRequests',newData().lastRenewalRequestId)).data.status=='approved' && getAfter(colonyDocPath(colonyId,'tenantLeaseRenewalRequests',newData().lastRenewalRequestId)).data.leaseId==leaseId && getAfter(colonyDocPath(colonyId,'tenantLeaseRenewalRequests',newData().lastRenewalRequestId)).data.requestedEndDate==newData().leaseEnd);

allow delete:if false;

}
function validTenantLeaseRenewalRequest(data,leaseId){let leasePath=colonyDocPath(colonyId,'tenantLeases',leaseId);

return data.keys().hasAll(['leaseId','tenantResidentId','requesterUid','householdId','tenantName','blockId','houseNumber','currentLeaseEnd','requestedEndDate','note','status','requestedAt','createdAt','updatedAt']) && data.keys().hasOnly(['leaseId','tenantResidentId','requesterUid','householdId','tenantName','blockId','houseNumber','currentLeaseEnd','requestedEndDate','note','status','requestedAt','createdAt','updatedAt','reviewNote','reviewedBy','reviewedAt']) && data.leaseId==leaseId && exists(leasePath) && get(leasePath).data.status=='active' && get(leasePath).data.tenantResidentId==data.tenantResidentId && get(leasePath).data.householdId==data.householdId && data.tenantResidentId is string && data.requesterUid==uid() && data.currentLeaseEnd==get(leasePath).data.leaseEnd && data.requestedEndDate is timestamp && data.requestedEndDate>get(leasePath).data.leaseEnd && data.note is string && data.note.size()<=400 && data.status=='pending' && data.requestedAt==request.time && data.createdAt==request.time && data.updatedAt==request.time;

}
match /tenantLeaseRenewalRequests/{requestId}{
allow get,list:if isAdmin(colonyId) || (isResident(colonyId) && isOwnResidentRecord(colonyId,oldData().tenantResidentId));

allow create:if isResident(colonyId) && newData().leaseId is string && isOwnResidentRecord(colonyId,newData().tenantResidentId) && validTenantLeaseRenewalRequest(newData(),newData().leaseId);

allow update:if(isResident(colonyId) && isOwnResidentRecord(colonyId,oldData().tenantResidentId) && oldData().status=='rejected' && newData().status=='pending' && changedKeys().hasOnly(['currentLeaseEnd','requestedEndDate','note','status','requestedAt','updatedAt','reviewNote','reviewedBy','reviewedAt']) && newData().requestedEndDate is timestamp && newData().currentLeaseEnd==get(colonyDocPath(colonyId,'tenantLeases',oldData().leaseId)).data.leaseEnd && get(colonyDocPath(colonyId,'tenantLeases',oldData().leaseId)).data.status=='active' && newData().requestedEndDate>get(colonyDocPath(colonyId,'tenantLeases',oldData().leaseId)).data.leaseEnd && newData().note is string && newData().note.size()<=400 && newData().requestedAt==request.time && newData().updatedAt==request.time && !('reviewNote'in newData()) && !('reviewedBy'in newData()) && !('reviewedAt'in newData())) || (isAdmin(colonyId) && oldData().status=='pending' && newData().status in['approved','rejected'] && changedKeys().hasOnly(['status','reviewNote','reviewedBy','reviewedAt','updatedAt']) && newData().reviewNote is string && newData().reviewNote.size()<=500 && newData().reviewedBy==uid() && newData().reviewedAt==request.time && newData().updatedAt==request.time && (newData().status!='approved' || (getAfter(colonyDocPath(colonyId,'tenantLeases',oldData().leaseId)).data.leaseEnd==oldData().requestedEndDate && getAfter(colonyDocPath(colonyId,'tenantLeases',oldData().leaseId)).data.lastRenewalRequestId==requestId)));

allow delete:if false;

}}
match /colonies/{colonyId}{
allow get:if isActiveColonyMember(colonyId);

allow list:if false;

allow create,update,delete:if false;

match /members/{memberId}{
allow get:if isOwnAccount(memberId) && oldData().uid==uid() && oldData().colonyId==colonyId;

allow list:if false;

allow create,delete:if false;

allow update:if isAdmin(colonyId) && oldData().role=='resident' && oldData().status=='active' && newData().status=='inactive' && changedKeys().hasOnly(['status','moveOutRequestId']) && newData().moveOutRequestId is string && existsAfter(colonyDocPath(colonyId,'moveRequests',newData().moveOutRequestId)) && getAfter(colonyDocPath(colonyId,'moveRequests',newData().moveOutRequestId)).data.requestType=='move_out' && getAfter(colonyDocPath(colonyId,'moveRequests',newData().moveOutRequestId)).data.status=='completed' && getAfter(colonyDocPath(colonyId,'moveRequests',newData().moveOutRequestId)).data.requesterUid==memberId && getAfter(colonyDocPath(colonyId,'moveRequests',newData().moveOutRequestId)).data.requesterResidentId==oldData().residentId;

match /pushInstallations/{installationId}{
allow get,list:if isActiveColonyMember(colonyId) && request.auth!=null && uid()==memberId;

allow create,update:if isActiveColonyMember(colonyId) && request.auth!=null && uid()==memberId && hasExactKeys(newData(),['fid','platform','updatedAt']) && newData().fid==installationId && newData().fid is string && newData().fid.size()>=10 && newData().fid.size()<=160 && newData().platform in['android','ios'] && newData().updatedAt==request.time;

allow delete:if isActiveColonyMember(colonyId) && request.auth!=null && uid()==memberId;

}
allow get,list:if isAdmin(colonyId);

}
function validAnnouncementPublishedNotification(data,colonyId){let path=colonyDocPath(colonyId,'announcements',data.sourceId);

return isAdmin(colonyId) && data.eventType=='announcement_published' && data.recipientKeys.hasAll(['role:resident','role:cleanliness_manager','role:worker']) && data.recipientKeys.hasOnly(['role:resident','role:cleanliness_manager','role:worker']) && existsAfter(path) && getAfter(path).data.status=='published' && getAfter(path).data.updatedAt==request.time && (!exists(path) || get(path).data.status!='published');

}
function validVisitorRegisteredNotification(data,colonyId){let path=colonyDocPath(colonyId,'visitors',data.sourceId);

return isResident(colonyId) && data.eventType=='visitor_registered' && data.recipientKeys.hasAll(['role:admin']) && data.recipientKeys.hasOnly(['role:admin']) && !exists(path) && existsAfter(path) && getAfter(path).data.createdBy==uid() && getAfter(path).data.createdByRole=='resident' && getAfter(path).data.hostUid==uid() && getAfter(path).data.status=='expected';

}
function validVisitorGateNotification(data,colonyId){let path=colonyDocPath(colonyId,'visitors',data.sourceId);

return isAdmin(colonyId) && data.eventType in['visitor_checked_in','visitor_checked_out'] && exists(path) && existsAfter(path) && get(path).data.hostUid is string && get(path).data.hostUid.size()>0 && getAfter(path).data.status!=get(path).data.status && ((data.eventType=='visitor_checked_in' && getAfter(path).data.status=='checked_in') || (data.eventType=='visitor_checked_out' && getAfter(path).data.status=='checked_out')) && data.recipientKeys.hasAll(['user:'+get(path).data.hostUid]) && data.recipientKeys.hasOnly(['user:'+get(path).data.hostUid]);

}
function validHousekeepingSubmittedNotification(data,colonyId){let path=colonyDocPath(colonyId,'housekeepingRequests',data.sourceId);

return isResident(colonyId) && data.eventType=='housekeeping_submitted' && data.recipientKeys.hasAll(['role:admin']) && data.recipientKeys.hasOnly(['role:admin']) && !exists(path) && existsAfter(path) && getAfter(path).data.requestedBy==uid() && getAfter(path).data.status=='submitted';

}
function validHousekeepingAssignedNotification(data,colonyId){let path=colonyDocPath(colonyId,'housekeepingRequests',data.sourceId);

let assignedWorker=getAfter(path).data.assignedWorkerId;

let residentUid=getAfter(path).data.requestedBy;

return isAdmin(colonyId) && data.eventType=='housekeeping_assigned' && exists(path) && existsAfter(path) && getAfter(path).data.status=='assigned' && getAfter(path).data.assignedBy==uid() && assignedWorker is string && assignedWorker.size()>0 && residentUid is string && residentUid.size()>0 && (get(path).data.status!='assigned' || get(path).data.assignedWorkerId!=assignedWorker) && data.recipientKeys.hasAll(['worker:'+assignedWorker,'user:'+residentUid]) && data.recipientKeys.hasOnly(['worker:'+assignedWorker,'user:'+residentUid]);

}
function validHousekeepingStatusNotification(data,colonyId){let path=colonyDocPath(colonyId,'housekeepingRequests',data.sourceId);

let memberPath=colonyDocPath(colonyId,'members',uid());

return isWorker(colonyId) && data.eventType=='housekeeping_updated' && exists(path) && existsAfter(path) && get(path).data.assignedWorkerId==get(memberPath).data.workerId && getAfter(path).data.status!=get(path).data.status && getAfter(path).data.status in['in_progress','completed'] && getAfter(path).data.requestedBy is string && data.recipientKeys.hasAll(['user:'+getAfter(path).data.requestedBy]) && data.recipientKeys.hasOnly(['user:'+getAfter(path).data.requestedBy]);

}
function validWaterDeliveryNotification(data,colonyId){let path=colonyDocPath(colonyId,'waterDeliveries',data.sourceId);

return isAdmin(colonyId) && data.eventType=='water_delivery_updated' && data.recipientKeys.hasAll(['role:resident']) && data.recipientKeys.hasOnly(['role:resident']) && existsAfter(path) && ((!exists(path) && getAfter(path).data.createdBy==uid() && getAfter(path).data.status in['scheduled','delivered']) || (exists(path) && getAfter(path).data.status!=get(path).data.status && getAfter(path).data.status in['scheduled','delivered','cancelled']));

}
function validBillIssuedNotification(data,colonyId){let path=colonyDocPath(colonyId,'maintenanceBills',data.sourceId);

return isAdmin(colonyId) && data.eventType=='bill_issued' && data.recipientKeys.hasAll(['role:resident']) && data.recipientKeys.hasOnly(['role:resident']) && !exists(path) && existsAfter(path) && getAfter(path).data.createdBy==uid() && getAfter(path).data.status=='unpaid' && getAfter(path).data.householdId is string;

}
function validPaymentSubmittedNotification(data,colonyId){let path=colonyDocPath(colonyId,'maintenancePayments',data.sourceId);

return isResident(colonyId) && data.eventType=='payment_submitted' && data.recipientKeys.hasAll(['role:admin']) && data.recipientKeys.hasOnly(['role:admin']) && !exists(path) && existsAfter(path) && getAfter(path).data.submittedBy==uid() && getAfter(path).data.createdBy==uid() && getAfter(path).data.status=='pending';

}
function validPaymentReviewedNotification(data,colonyId){let path=colonyDocPath(colonyId,'maintenancePayments',data.sourceId);

let submittedBy=get(path).data.submittedBy;

return isAdmin(colonyId) && data.eventType in['payment_verified','payment_rejected'] && exists(path) && existsAfter(path) && get(path).data.status=='pending' && getAfter(path).data.status!=get(path).data.status && ((data.eventType=='payment_verified' && getAfter(path).data.status=='verified') || (data.eventType=='payment_rejected' && getAfter(path).data.status=='rejected')) && submittedBy is string && data.recipientKeys.hasAll(['user:'+submittedBy]) && data.recipientKeys.hasOnly(['user:'+submittedBy]);

}
function validV2NotificationEvent(data,colonyId){
return data.eventType=='complaint_submitted'
? validResidentComplaintNotification(data,colonyId)
: data.eventType=='complaint_status_changed'
? validAdminComplaintStatusNotification(data,colonyId)
: data.eventType=='task_assigned'
? validTaskAssignedNotification(data,colonyId)
: data.eventType=='task_status_changed'
? validManagerTaskStatusNotification(data,colonyId)
: data.eventType=='maintenance_job_updated'
? validMaintenanceJobUpdateNotification(data,colonyId)
: data.eventType=='announcement_published'
? validAnnouncementPublishedNotification(data,colonyId)
: data.eventType=='visitor_registered'
? validVisitorRegisteredNotification(data,colonyId)
: data.eventType in['visitor_checked_in','visitor_checked_out']
? validVisitorGateNotification(data,colonyId)
: data.eventType=='housekeeping_submitted'
? validHousekeepingSubmittedNotification(data,colonyId)
: data.eventType=='housekeeping_assigned'
? validHousekeepingAssignedNotification(data,colonyId)
: data.eventType=='housekeeping_updated'
? validHousekeepingStatusNotification(data,colonyId)
: data.eventType=='water_delivery_updated'
? validWaterDeliveryNotification(data,colonyId)
: data.eventType=='bill_issued'
? validBillIssuedNotification(data,colonyId)
: data.eventType=='payment_submitted'
? validPaymentSubmittedNotification(data,colonyId)
: data.eventType in['payment_verified','payment_rejected']
? validPaymentReviewedNotification(data,colonyId)
: false;

}
match /notifications/{notificationId}{
allow get,list:if canReadColonyNotification(colonyId,oldData());

allow create:if validV2NotificationEvent(newData(),colonyId) && validColonyNotification(newData());

allow update,delete:if false;

}
match /members/{memberId}/notificationReads/{notificationId}{
allow get,list:if isActiveColonyMember(colonyId) && uid()==memberId;

allow create:if isActiveColonyMember(colonyId) && uid()==memberId && hasExactKeys(newData(),['readAt']) && newData().readAt==request.time && exists(colonyDocPath(colonyId,'notifications',notificationId)) && canReadColonyNotification(colonyId,get(colonyDocPath(colonyId,'notifications',notificationId)).data);

allow update,delete:if false;

}
match /households/{householdId}{
allow get:if isAdmin(colonyId) || isResidentInHousehold(colonyId,householdId);

allow list:if isAdmin(colonyId);

allow create:if isAdmin(colonyId) && validHousehold(newData()) && newData().createdBy==uid() && newData().createdAt==request.time && newData().updatedAt==request.time;

allow update:if isAdmin(colonyId) && validHousehold(newData()) && newData().createdBy==oldData().createdBy && newData().createdAt==oldData().createdAt && newData().updatedAt==request.time;

allow delete:if false;

}
match /residents/{residentId}{
allow get:if isAdmin(colonyId) || isOwnResidentRecord(colonyId,residentId);

allow list:if isAdmin(colonyId) || (isResident(colonyId) && isResidentInHousehold(colonyId,oldData().householdId));

allow create:if isAdmin(colonyId) && validResident(newData()) && newData().createdBy==uid() && newData().createdAt==request.time && newData().updatedAt==request.time && exists(colonyDocPath(colonyId,'households',newData().householdId));

allow update:if isAdmin(colonyId) && validResident(newData()) && newData().createdBy==oldData().createdBy && newData().createdAt==oldData().createdAt && newData().updatedAt==request.time && exists(colonyDocPath(colonyId,'households',newData().householdId));

allow delete:if false;

allow get,list:if isAdmin(colonyId) || hasCommitteePermission(colonyId,'residents.view');

}
match /residentLoginRegistrations/{residentId}{
allow get,list:if isAdmin(colonyId);

allow create:if isAdmin(colonyId) && validResidentLoginRegistration(newData(),residentId) && !('linkedUid'in newData()) && !('linkedAt'in newData()) && !('verifiedPhoneNumberE164'in newData()) && newData().createdBy==uid() && newData().createdAt==request.time && newData().updatedAt==request.time && existsAfter(colonyDocPath(colonyId,'residents',residentId));

allow update:if isAdmin(colonyId) && validResidentLoginRegistration(newData(),residentId) && newData().residentId==oldData().residentId && newData().createdBy==oldData().createdBy && newData().createdAt==oldData().createdAt && newData().get('linkedUid','')==oldData().get('linkedUid','') && newData().get('linkedAt',null)==oldData().get('linkedAt',null) && newData().get('verifiedPhoneNumberE164','')==oldData().get('verifiedPhoneNumberE164','') && (oldData().get('linkedUid','')=='' || (newData().phoneNumber==oldData().phoneNumber && newData().phoneNumberE164==oldData().phoneNumberE164 && newData().status=='linked')) && newData().updatedAt==request.time && exists(colonyDocPath(colonyId,'residents',residentId));

allow delete:if false;

