match /colonyExpenses/{expenseId}{
function validColonyExpense(data){
return data.keys().hasAll(['title','category','amount','amountPaid','paymentStatus','paymentMethod','expenseDate','monthKey','payeeName','vendorName','assetName','reference','notes','createdBy','createdByName','createdAt','updatedAt'])
&& data.keys().hasOnly(['title','category','amount','amountPaid','paymentStatus','paymentMethod','expenseDate','monthKey','payeeName','vendorName','assetName','reference','notes','createdBy','createdByName','createdAt','updatedAt','payrollRunId','payrollStaffEntryId','payrollPaymentId'])
&& data.title is string
&& data.title.size()>=2
&& data.title.size()<=120
&& data.category in['utilities','water','security','housekeeping','repairs','landscaping','staff','insurance','administration','other']
&& data.amount is number
&& data.amount>0
&& data.amount<=1000000000
&& data.amountPaid is number
