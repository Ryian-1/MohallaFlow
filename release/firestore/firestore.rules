function validWaterIncident(data){return hasExactKeys(data,['title','incidentType','severity','affectedArea','assignedTo','description','status','openedAt','resolvedAt','resolutionNotes','createdBy','createdAt','updatedAt']) && data.title is string && data.title.size()>0 && data.incidentType in['shortage','leakage','contamination','pump_failure','overflow','supply_disruption','other'] && data.severity in['low','medium','high','critical'] && data.affectedArea is string && data.affectedArea.size()>0 && data.assignedTo is string && data.description is string && data.status in['open','in_progress','resolved','closed'] && data.openedAt is timestamp && (data.resolvedAt==null || data.resolvedAt is timestamp) && data.resolutionNotes is string && data.createdBy==uid() && data.createdAt==request.time && data.updatedAt==request.time;

